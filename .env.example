# ─── Database ────────────────────────────────────────────────────────────────
# Local docker: docker compose up -d db
DATABASE_URL=postgres://winthrop:winthrop@localhost:5433/winthrop
# Neon (prod/preview): use the pooled connection string.

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_ORG_SLUG=friends-of-winthrop
# Shared secret for /api/cron/* route handlers (Vercel Cron sends it as Authorization: Bearer).
CRON_SECRET=

# ─── Auth.js (magic link via Resend) ─────────────────────────────────────────
AUTH_SECRET=            # openssl rand -base64 32
AUTH_RESEND_KEY=        # same as RESEND_API_KEY
AUTH_EMAIL_FROM="Friends of Winthrop <login@example.org>"
# Dev only: when set to true and no AUTH_RESEND_KEY, magic links are logged to the console.
AUTH_DEV_LOG_LINKS=true

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Friends of Winthrop <store@example.org>"

# ─── Run Payments (Javelin) API ──────────────────────────────────────────────
RUN_API_BASE_URL=https://javelin.runpayments.io/api/v1
RUN_GOD_MODE_TOKEN=
RUN_API_KEY=
RUN_API_TIMEOUT_MS=30000
# dollars ("12.34", what the shipped apps send) | cents (12 34 -> 1234, what swagger says). Settle via UAT probe.
RUN_AMOUNT_UNITS=dollars

# ─── Runner.js (browser tokenization) ────────────────────────────────────────
NEXT_PUBLIC_RUNNER_VERSION=1.5.4
NEXT_PUBLIC_RUN_SCRIPT_URL=
# local | staging | production
NEXT_PUBLIC_RUNNER_ENV=staging

# ─── reCAPTCHA v3 (public checkout only) ─────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ─── Seed (lib/db/seed.ts) ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=mike@runpayments.io
SEED_RUN_MID=
SEED_RUN_PUBLIC_KEY=

# Dev only: approve/decline charges locally without UAT keys (see lib/run-api/index.ts)
RUN_MOCK_GATEWAY=false
NEXT_PUBLIC_RUN_MOCK_GATEWAY=false

# Run Payments webhooks (X-Webhook-Signature-256: sha256=<hmac of raw body>); share the endpoint /api/webhooks/run with Run
RUN_WEBHOOK_SECRET=
# Days after delivery before student names are purged from orders
STUDENT_NAME_RETENTION_DAYS=90
